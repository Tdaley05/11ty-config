<!doctype html>
<html lang="en">
<head>
     <meta charset="UTF-8">
     <meta name="viewport"
           content="width=device-width,
           user-scalable=no,
           initial-scale=1.0,
           maximum-scale=1.0,
           minimum-scale=1.0">
     <meta http-equiv="X-UA-Compatible"
           content="ie=edge">
     <title></title>
     <link rel="stylesheet" href="css/styles.css">
     <script type="module" src="js/is-land.js"></script>

</head>
<body>

    {{ content | safe }}
{% include "layouts/navbar.html" %}


<strong>Page last updated:</strong>
{% if gitLastCommit %}
  <time class="fmt-date" datetime="{{ gitLastCommit }}">{{ gitLastCommit }}</time>
{% else %}
  <em>not yet committed</em>
{% endif %}
&middot;
<strong>Site last built:</strong>
<time class="fmt-date" datetime="{{ build.timestamp }}">{{ build.timestamp }}</time>

<is-land on:visible>
  <template data-island>
    <script type="module">
      const fmt = new Intl.DateTimeFormat(undefined, {
        dateStyle: "medium",
        timeStyle: "short"
      });
      document.querySelectorAll("time.fmt-date").forEach((el) => {
        el.textContent = fmt.format(new Date(el.getAttribute("datetime")));
      });
    </script>
  </template>
</is-land>


</body>
</html>
